*.slnx
.utmp/

# Crash / profiler / build artifacts
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Local tooling
.claude/settings.local.json

# Burst WebGL build output written to the project root
/Data/
